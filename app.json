{
  "name": "Financial MCP Server",
  "description": "Remote MCP server for financial analysis, market summaries, and stock alerts.",
  "repository": "https://github.com/osamadev/financial_mcp_server",
  "keywords": ["mcp", "finance", "claude", "model-context-protocol"],
  "stack": "container",
  "env": {
    "MCP_TRANSPORT": { "value": "streamable-http" },
    "SERPAPI_API_KEY": { "description": "SerpAPI key for news fetching", "required": false },
    "TELEGRAM_BOT_TOKEN": { "description": "Telegram bot token for alerts", "required": false },
    "TELEGRAM_USER_ID": { "description": "Telegram chat/user id for alerts", "required": false },
    "OLLAMA_HOST": { "description": "Reachable Ollama URL for summaries (optional)", "required": false }
  }
}
