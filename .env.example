# ---- Transport / networking (set by Docker & render.yaml for cloud) ----
# stdio (local Claude Desktop) | streamable-http (remote server)
MCP_TRANSPORT=streamable-http
HOST=0.0.0.0
PORT=8000

# ---- Secrets ----
SERPAPI_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=

# ---- Optional: news summarization LLM (financial_context tool) ----
# Point at a reachable Ollama instance; localhost will NOT exist in the cloud.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=mistral

# ---- Optional: persist portfolio across redeploys (mount a volume here) ----
# PORTFOLIO_FILE=/data/user_portfolio.json
