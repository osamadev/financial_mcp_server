# ---- Transport / networking (set by Docker & render.yaml for cloud) ----
# stdio (local Claude Desktop) | streamable-http (remote server)
MCP_TRANSPORT=streamable-http
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# ---- Secrets ----
MCP_ACCESS_TOKEN=
SERPAPI_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=

# ---- Authentication mode (streamable-http) ----
# static: simple bearer token via MCP_ACCESS_TOKEN
# oauth: validate JWT from external OIDC provider
# none: only for local dev with ALLOW_UNAUTHENTICATED_HTTP=true
MCP_AUTH_MODE=static

# ---- OAuth / OIDC (used when MCP_AUTH_MODE=oauth) ----
OAUTH_ISSUER_URL=
# Optional; if empty, server discovers jwks_uri from issuer metadata:
OAUTH_JWKS_URL=
# Single audience or comma-separated list (e.g. api://client-id,client-id-guid)
OAUTH_AUDIENCE=
OAUTH_REQUIRED_SCOPES=mcp:tools
# Public URL of this MCP server (required for oauth mode; optional for static — omit for bearer-only):
MCP_RESOURCE_SERVER_URL=

# ---- Optional: news summarization LLM (financial_context tool) ----
# SUMMARIZER_PROVIDER can be: ollama | openai | auto
SUMMARIZER_PROVIDER=ollama
# Point at a reachable Ollama instance; localhost will NOT exist in the cloud.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=mistral
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional custom OpenAI-compatible base URL:
# OPENAI_BASE_URL=

# ---- Optional: if true, allows streamable-http without token (dev only) ----
# ALLOW_UNAUTHENTICATED_HTTP=false

# ---- Optional: enables Telegram message sends from alert checks ----
# ENABLE_TELEGRAM_ALERTS=false

# ---- Optional: persist portfolio across redeploys (mount a volume here) ----
# PORTFOLIO_FILE=/data/user_portfolio.json
