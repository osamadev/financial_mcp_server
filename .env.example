# ---- Transport / networking (set by Docker & render.yaml for cloud) ----
# stdio (local Claude Desktop) | streamable-http (remote server)
MCP_TRANSPORT=streamable-http
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# ---- Secrets ----
MCP_ACCESS_TOKEN=
SERPAPI_API_KEY=
# Optional — reserved for future use; stock quotes currently use yfinance (not read by server yet)
ALPHA_VANTAGE_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=

# ---- Authentication mode (streamable-http) ----
# static: simple bearer token via MCP_ACCESS_TOKEN
# oauth: validate JWT from external OIDC provider
# none: only for local dev with ALLOW_UNAUTHENTICATED_HTTP=true
MCP_AUTH_MODE=static

# ---- OAuth / OIDC (used when MCP_AUTH_MODE=oauth) ----
# Entra client app ID/secret go in Claude connector settings, not here. See DEPLOY.md#oauth-entra-id
OAUTH_ISSUER_URL=
# Optional additional issuers (space or comma-separated) for token validation.
# Example: https://sts.windows.net/<tenant-id>/
OAUTH_ISSUER_URLS=
# Optional; if empty, server discovers jwks_uri from issuer metadata:
OAUTH_JWKS_URL=
# Single audience or comma-separated list (e.g. api://client-id,client-id-guid)
OAUTH_AUDIENCE=
# Required scopes for JWT validation. For Entra, use what appears in token `scp`
# (often `mcp.tools` short name).
OAUTH_REQUIRED_SCOPES=mcp.tools
# Optional scopes advertised in MCP protected-resource metadata.
# Set to full Entra scope to avoid AADSTS9010010 in strict clients:
# OAUTH_SCOPES_SUPPORTED=api://<api-app-client-id>/mcp.tools
OAUTH_SCOPES_SUPPORTED=
# Public URL of this MCP server (required for oauth mode; optional for static — omit for bearer-only):
MCP_RESOURCE_SERVER_URL=

# ---- Optional OAuth broker (Claude + Entra workaround) ----
# When true, protected-resource metadata points Claude to this server's /authorize and /token.
# The broker strips the MCP resource URL before forwarding OAuth requests to Entra.
OAUTH_BROKER_ENABLED=false
# Public origin for this service (no /mcp), defaults to MCP_RESOURCE_SERVER_URL origin.
OAUTH_BROKER_ISSUER_URL=
# Optional Entra client override; if empty, broker forwards Claude's client_id/client_secret.
OAUTH_BROKER_CLIENT_ID=
OAUTH_BROKER_CLIENT_SECRET=
# Full Entra API scope requested from Entra. Defaults to OAUTH_SCOPES_SUPPORTED or OAUTH_REQUIRED_SCOPES.
OAUTH_BROKER_SCOPE=

# ---- Optional: news summarization LLM (financial_context tool) ----
# SUMMARIZER_PROVIDER can be: ollama | openai | auto
SUMMARIZER_PROVIDER=ollama
# Point at a reachable Ollama instance; localhost will NOT exist in the cloud.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=mistral
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional custom OpenAI-compatible base URL:
# OPENAI_BASE_URL=

# ---- Optional: if true, allows streamable-http without token (dev only) ----
# ALLOW_UNAUTHENTICATED_HTTP=false

# ---- Optional: enables Telegram message sends from alert checks ----
# ENABLE_TELEGRAM_ALERTS=false

# ---- Optional: persist portfolio across redeploys (mount a volume here) ----
# PORTFOLIO_FILE=/data/user_portfolio.json
